{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/schema/tauri.schema.json",
    "productName": "Billly",
    "version": "0.4.0",
    "identifier": "com.oli.billly",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Billly",
                "label": "main",
                "width": 1500,
                "height": 1050,
                "minWidth": 1500,
                "minHeight": 1050,
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": ["../client_secret.json"],
        "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
    }
}
